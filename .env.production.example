# SACK3D Production Environment Variables
# Copy this file to .env on your MilesWeb server and configure your values

# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=production
# In MilesWeb/cPanel, PORT is often assigned automatically by Passenger.
# If running standalone or on VPS, 5000 is default.
PORT=5000
# On cPanel Passenger, leave HOST empty or set 0.0.0.0 on VPS
HOST=0.0.0.0
# Trust reverse proxy headers (Nginx/Apache/Passenger)
TRUST_PROXY=1

# Allowed CORS origins (comma-separated live domain names)
ALLOWED_ORIGINS=https://sack3d.com,https://www.sack3d.com

# ======================
# DATABASE (MilesWeb MySQL)
# ======================
# Note: On cPanel hosting, DB_NAME and DB_USER are prefixed with your cPanel username (e.g. sack3d_sack)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_milesweb_mysql_user
DB_PASSWORD=your_milesweb_mysql_password
DB_NAME=your_milesweb_database_name
# Optional: Unix domain socket for fast cPanel local MySQL (e.g. /var/lib/mysql/mysql.sock)
# DB_SOCKET_PATH=/var/lib/mysql/mysql.sock
DB_CONNECTION_LIMIT=15

# Set to true to skip checking/running seeds completely if sack.sql is already imported
SKIP_SEEDS=false

# ======================
# JWT AUTHENTICATION
# ======================
# Generate a strong 64+ char secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER prefix with VITE_ to keep private from client bundles
JWT_SECRET=GENERATE_A_STRONG_64_CHARACTER_SECRET_HERE

# ======================
# STRIPE PAYMENT KEYS
# ======================
# From https://dashboard.stripe.com/apikeys
# Secret key stays on server only (NEVER expose to client)
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY

# Webhook endpoint: https://sack3d.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LIVE_WEBHOOK_SECRET

# ======================
# APPLICATION URLS
# ======================
FRONTEND_URL=https://sack3d.com
BASE_URL=https://sack3d.com

# ======================
# 3D MODEL FILE UPLOADS & STORAGE
# ======================
# Maximum 3D model upload size in MB (e.g. 100 for 100MB models)
MAX_UPLOAD_SIZE_MB=100
STORAGE_PROVIDER=local
# Optional custom upload directory path (defaults to ./public/uploads)
# UPLOAD_DIR=/home/sack3d/public_html/uploads

# ======================
# VITE FRONTEND VARIABLES (Built into client bundle)
# ======================
# Leave empty for relative same-origin API requests on live domain (recommended),
# or specify if your API is hosted on a separate sub-domain (e.g., https://api.sack3d.com)
VITE_API_URL=
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY
