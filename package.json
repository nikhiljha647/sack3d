{
  "name": "sack3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"blue,magenta\" \"node --watch server/server.js\" \"vite\"",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "start:dev": "node server/server.js",
    "watch": "node --watch server/server.js",
    "server": "node --watch server/server.js",
    "client": "vite",
    "build": "vite build",
    "build:production": "cross-env NODE_ENV=production vite build",
    "production": "npm run build:production && npm start",
    "lint": "oxlint",
    "preview": "vite preview",
    "health": "node -e \"fetch('http://localhost:5000/health').then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.51.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^23.0.0",
    "three": "^0.186.1",
    "uuid": "^14.0.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
