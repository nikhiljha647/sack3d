# ModelAR SaaS Platform Configuration
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5173

# Database configuration (Default is SQLite file, can point to MySQL / Postgres)
DB_PATH=./server/data/modelar.db
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=modelar

# JWT Authentication
JWT_SECRET=modelar-super-secret-key-prod-2026

# Stripe / Payment Gateway Configuration
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# For production, use live keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_sample_stripe_key_modelar
STRIPE_SECRET_KEY=sk_test_sample_stripe_key_modelar
# Webhook secret from: https://dashboard.stripe.com/test/webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_sample_webhook_secret

# Frontend URL (for Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173

# Object Storage / CDN (AWS S3 / Cloudflare R2 ready)
STORAGE_PROVIDER=local # 'local', 's3', 'r2'
# S3_BUCKET=modelar-assets
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Frontend Environment Variables (Vite)
# Create a separate .env file in the root for these
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_API_URL=http://localhost:5000
